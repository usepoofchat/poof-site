{
  "name": "poof-site",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "node deploy.mjs",
    "deploy:dry": "node deploy.mjs --dry",
    "brand-zip": "node scripts/brand-zip.mjs",
    "build:walletconnect": "esbuild walletconnect/index.ts --bundle --format=esm --minify --target=es2022 --legal-comments=none --define:global=globalThis --define:process.env.NODE_ENV='\"production\"' --outfile=wallet/poof-walletconnect.js",
    "build:solana": "esbuild solana/index.ts --bundle --format=esm --minify --target=es2022 --legal-comments=none --define:process.env.NODE_ENV='\"production\"' --outfile=wallet/poof-solana.js"
  },
  "dependencies": {
    "basic-ftp": "^5.0.5"
  },
  "devDependencies": {
    "@solana-program/compute-budget": "^0.19.0",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.4.0",
    "@wallet-standard/app": "^1.1.1",
    "@walletconnect/universal-provider": "2.25.0",
    "esbuild": "^0.25.0"
  }
}
