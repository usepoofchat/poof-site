# Copy this file to .env and fill it in. .env stays on your computer only.
# The values come from the FTP account settings of the hosting.
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
# Folder on the server where the site lives, relative to the FTP account root.
FTP_DIR=/
# Encrypted connection (FTPS). Leave true.
FTP_SECURE=true
