# Copy this file to .env and fill it in. .env stays on your computer only.
# All values come from cPanel -> FTP Accounts -> (your account) -> Configure FTP Client.
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
# Folder on the server where the site lives. If the FTP account was created with
# directory "public_html", its root already IS public_html, so keep "/".
FTP_DIR=/
# Encrypted connection (FTPS). Leave true.
FTP_SECURE=true
